{
  "name": "@road-signs/me",
  "version": "0.1.0",
  "description": "Montenegro road signs — TypeScript registry, inline SVGs, and image assets",
  "keywords": [
    "zbsp",
    "road-signs",
    "signs",
    "svg",
    "typescript",
    "montenegro",
    "me"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karlnorling/road-signs",
    "directory": "packages/@road-signs/me"
  },
  "files": [
    "dist/",
    "assets/",
    "package.json",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})); require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "test": "jest --passWithNoTests",
    "type-check": "tsc --noEmit -p tsconfig.cjs.json"
  },
  "dependencies": {
    "@road-signs/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  }
}
