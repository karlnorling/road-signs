---
interface SignAssets {
  jpg: Record<number, string>;
  png: Record<number, string>;
  svg?: string;
  webp: Record<number, string>;
}

interface Sign {
  id: string;
  code: string;
  name: string;
  category: string;
  svg?: string;
  description: string;
  assets: SignAssets;
}

interface Props {
  signs: Sign[];
  /**
   * Optional prefix for the gallery's DOM IDs so multiple instances can
   * coexist on the same page (the /compare page mounts two galleries).
   * Falls back to "gallery" for backwards compatibility.
   */
  id?: string;
}

const { signs, id = 'gallery' } = Astro.props;
const inputId = `${id}-search`;
const countId = `${id}-count`;
const gridId = `${id}-grid`;

// Derive categories present in this dataset — works for all country taxonomies.
const categories = [...new Set(signs.map((s) => s.category))].sort();

const categoryColors: Record<string, string> = {
  // Vienna Convention (SE, DE, FR, IT, ES, NL, PL, AT, BE, …)
  warning: '#e67e22',
  priority: '#c0392b',
  prohibitory: '#e74c3c',
  mandatory: '#2980b9',
  information: '#27ae60',
  // US MUTCD
  regulatory: '#e74c3c',
  guide: '#27ae60',
  school: '#f39c12',
  construction: '#d35400',
  recreational: '#2980b9',
  informational: '#8e44ad',
  // CA / UK / SE shared
  temporary: '#d35400',
  direction: '#16a085',
};

const categoryCounts = Object.fromEntries(
  categories.map((cat) => [cat, signs.filter((s) => s.category === cat).length]),
);

const categoryLabel = (cat: string) =>
  cat.charAt(0).toUpperCase() + cat.slice(1);
---

<div class="gallery">
  <div class="gallery-controls">
    <input
      type="search"
      id={inputId}
      placeholder="Search by name or code…"
      aria-label="Search signs"
    />
    {
      categories.length > 1 && (
        <div class="category-filters" role="group" aria-label="Filter by category">
          {categories.map((cat) => (
            <button
              class="filter-btn"
              data-category={cat}
              style={`--cat-color: ${categoryColors[cat] ?? '#888'}`}
              aria-pressed="false"
            >
              {categoryLabel(cat)}
              <span class="count">({categoryCounts[cat]})</span>
            </button>
          ))}
        </div>
      )
    }
  </div>

  <p class="gallery-count" id={countId}>
    {
      signs.length === 0
        ? 'No signs yet — run yarn update --country=XX to populate.'
        : `${signs.length} sign${signs.length !== 1 ? 's' : ''}`
    }
  </p>

  <div class="sign-grid" id={gridId}>
    {
      signs.map((sign) => {
        // Prefer inline SVG; fall back to the largest PNG raster for PDF-extracted signs.
        const fallbackPng = sign.assets?.png
          ? sign.assets.png[2048] ?? sign.assets.png[1024] ?? sign.assets.png[768] ?? sign.assets.png[512] ?? sign.assets.png[240]
          : undefined;
        return (
          <div
            class="sign-card"
            data-category={sign.category}
            data-name={sign.name.toLowerCase()}
            data-code={sign.code.toLowerCase()}
            title={sign.description}
          >
            {sign.svg
              ? <div class="sign-svg" set:html={sign.svg} />
              : fallbackPng
                ? <div class="sign-svg"><img src={fallbackPng} alt={sign.name} loading="lazy" /></div>
                : <div class="sign-svg sign-missing" aria-hidden="true">—</div>
            }
            <span class="sign-code">{sign.code}</span>
            <span class="sign-name">{sign.name}</span>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .gallery-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  #gallery-search {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.9rem;
    width: 100%;
    max-width: 380px;
    outline-offset: 2px;
  }

  #gallery-search:focus {
    outline: 2px solid var(--sl-color-accent);
  }

  .category-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1.5px solid var(--cat-color, var(--sl-color-gray-5));
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 0.8rem;
    margin: 0;
    transition: background 0.15s, color 0.15s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .filter-btn .count {
    font-size: 0.72rem;
    opacity: 0.7;
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--cat-color);
    color: #fff;
    border-color: var(--cat-color);
  }

  .filter-btn[aria-pressed='true'] .count {
    opacity: 0.9;
  }

  .gallery-count {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 1rem;
  }

  .sign-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .sign-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.75rem 0.5rem 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-6);
    background: var(--sl-color-bg-sidebar);
    transition: border-color 0.15s;
    cursor: default;
    margin: 0;
  }

  .sign-card:hover {
    border-color: var(--sl-color-accent);
  }

  .sign-card.hidden {
    display: none;
  }

  .sign-svg {
    width: 112px;
    height: 112px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sign-svg :global(svg),
  .sign-svg :global(img) {
    width: 112px !important;
    height: 112px !important;
    display: block;
    flex-shrink: 0;
    object-fit: contain;
  }

  .sign-missing {
    color: var(--sl-color-gray-4);
    font-size: 1.4rem;
  }

  .sign-code {
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    color: var(--sl-color-gray-3);
    margin: 0;
  }

  .sign-name {
    font-size: 0.68rem;
    text-align: center;
    color: var(--sl-color-gray-2);
    line-height: 1.3;
    margin: 0;
  }
</style>

<script define:vars={{ inputId, gridId, countId }}>
  const searchInput = document.getElementById(inputId);
  const grid = document.getElementById(gridId);
  const countEl = document.getElementById(countId);
  if (searchInput && grid && countEl) {
    // Scope filter buttons to the wrapper that contains this grid so two
    // CountryGallery instances on /compare don't share category state.
    const wrapper = grid.closest('.gallery');
    const categoryBtns = wrapper
      ? wrapper.querySelectorAll('.filter-btn[data-category]')
      : document.querySelectorAll('.filter-btn[data-category]');

    let activeCategory = null;

    const update = () => {
      const q = searchInput.value.toLowerCase().trim();
      let visible = 0;
      grid.querySelectorAll('.sign-card').forEach((card) => {
        const matchesSearch =
          !q || card.dataset.name.includes(q) || card.dataset.code.includes(q);
        const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
        const show = matchesSearch && matchesCategory;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      countEl.textContent = `${visible} sign${visible !== 1 ? 's' : ''}`;
    };

    searchInput.addEventListener('input', update);
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category;
        activeCategory = activeCategory === cat ? null : cat;
        categoryBtns.forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.category === activeCategory)),
        );
        update();
      });
    });
  }
</script>
